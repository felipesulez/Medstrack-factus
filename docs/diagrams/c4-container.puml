@startuml c4-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Medstrack Billing — C4 Container Diagram [Level 2]

Person(client, "Medstracker", "Client system that issues invoices")

System_Boundary(system, "Billing System · Railway Cloud") {
Container(api, "REST API", "Spring Boot", "Receives HTTP requests and validates")
Container(service, "FactusService", "Spring Bean", "Business logic and OAuth2")
Container(interceptor, "TokenInterceptor", "Spring Component", "Auto-refreshes tokens")
}

System_Ext(factus, "Factus API", "Colombian e-invoicing platform")
System_Ext(dian, "DIAN", "Colombian Tax Authority")

Rel(client, api, "HTTPS / JSON", "POST /send")
Rel(api, service, "delegates", "logic")
Rel(service, interceptor, "uses", "auth")
Rel(service, factus, "HTTPS / REST", "validate")
Rel(factus, dian, "registers", "real-time")

SHOW_LEGEND()
@enduml